generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN

  STUDENT
  GUARDIAN

  STAFF
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum InviteType {
  STUDENT
  STAFF
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  userRoles UserRole[]

  student  Student?
  staff    Staff?
  guardian Guardian?

  activatedAt DateTime?
  invites     Invite[]

  @@unique([email])
  @@index([emailVerified])
  @@index([activatedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id String @id @default(cuid())

  name String
  slug String @unique

  logo        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  userRoles UserRole[]
  students  Student[]
  staffs    Staff[]

  @@index([slug])
}

model Branch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  address String?

  phone String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  staffs    Staff[]
  userRoles UserRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model UserRole {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role Role

  createdAt DateTime @default(now())

  @@unique([userId, organizationId, role], name: "userId_organizationId_role")
}

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  admissionNo String?
  rollNo      String?

  grade   String?
  section String?

  joinedAt DateTime?

  status           StudentStatus     @default(ACTIVE)
  guardianStudents GuardianStudent[]
  guardianInvites  GuardianInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([grade, section])
  @@index([admissionNo])
}

model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String?

  designation String
  department  String?

  joinedAt DateTime?

  status StaffStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([department])
  @@index([employeeId])
}

model Guardian {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guardianStudents GuardianStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianStudent {
  id String @id @default(cuid())

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Invite {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type InviteType

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([type])
}

model GuardianInvite {
  id String @id @default(cuid())

  token String @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([expiresAt])
}

enum WebsitePageKey {
  homepage
  about
  contact
  other
  faculty
  login
}

enum WebsitePageStatus {
  draft
  published
}

enum BlockType {
  hero
  headline
  intro
  stats
  cta
  featured_events
  featured_notices
  rich_text
  history
  mission_vision
  principal_message
  facilities
  achievements
  contact_details
  office_hours
  social_links
  map
  announcements
  gallery_grid
  faculty
  academics
  admissions_info
  auth_visual
  auth_intro
  auth_form
  auth_contact
  faculty_header
  faculty_leadership
  faculty_directory
}

model WebsitePage {
  id                    String         @id @default(cuid())
  key                   WebsitePageKey @unique
  title                 String
  path                  String
  status                WebsitePageStatus @default(draft)
  hasUnpublishedChanges Boolean        @default(true)
  seoTitle              String?
  seoDescription        String?
  seoKeywords           String?
  publishedAt           DateTime?
  updatedAt             DateTime       @updatedAt
  updatedBy             String
  createdAt             DateTime       @default(now())

  blocks ContentBlock[]

  @@index([status])
  @@index([path])
  @@map("website_page")
}

model ContentBlock {
  id        String     @id @default(cuid())
  type      BlockType
  label     String
  visible   Boolean    @default(true)
  order     Int
  fields    Json
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  pageId String
  page   WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@index([pageId, visible])
  @@map("content_block")
}

/// Public faculty directory. Mirrors the frontend Person shape so the
/// faculty-page-detail route is driven from the database instead of static files.
model FacultyMember {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  role          String
  department    String
  qualification String
  experience    String
  subjects      Json
  email         String
  extension     String
  officeHours   String
  bio           String
  joined        String
  leadership    Boolean  @default(false)
  rank          Int?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadership])
  @@index([department])
  @@map("faculty_member")
}

/// Public notice-board content, mirroring the frontend Notice shape. Complex
/// fields (paragraphs, bullets, tables, attachments) are stored as JSON.
model Notice {
  id          String   @id @default(cuid())
  ref         String
  title       String
  category    String
  dateAd      String
  dateBs      String
  audience    String
  issuedBy    String
  summary     String
  body        Json
  bullets     Json?
  table       Json?
  attachments Json
  pinned      Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([pinned])
  @@map("notice")
}

/// Public scholarship schemes, mirroring the frontend Scholarship shape.
model Scholarship {
  id          String   @id @default(cuid())
  ref         String
  name        String
  nepaliName  String
  category    String
  coverage    Int
  award       String
  amountNpr   Int
  seats       Int
  deadlineAd  String
  deadlineBs  String
  appliesTo   String
  summary     String
  description String
  eligibility Json
  benefits    Json
  documents   Json
  process     Json
  renewal     String
  contact     String
  spotlight   Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("scholarship")
}

/// Photo albums shown in the gallery page.
model Album {
  id        String   @id @default(cuid())
  event     String
  year      String
  category  String
  date      String?
  photos    Json     // Array of { src, alt, width, height }
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([year])
  @@map("album")
}

/// Campus facilities (Biology lab, Library, etc).
model Facility {
  id        String   @id @default(cuid())
  name      String
  room      String
  specs     Json     // strict string[]
  images    Json     // strict Img[] { src, alt }
  block     Json     // { d, cx, cy } for the interactive map
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("facility")
}

/// Downloadable resources for students/guardians.
model Resource {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  fileSize  String
  kind      String   @default("PDF")
  audience  String   @default("All")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("resource")
}

/// Board results tracking academic excellence over years.
model BoardResult {
  id             String   @id @default(cuid())
  board          String   // 'SEE' or 'NEB'
  year           String   // e.g. '2079'
  appeared       Int
  passed         Int
  distinction    Int
  firstDivision  Int
  secondDivision Int
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([board, year])
  @@map("board_result")
}

/// Bus routes for the transportation page.
model BusRoute {
  id          String   @id @default(cuid())
  busNumber   String
  driverName  String
  driverPhone String
  stops       Json     // Array of strings or {time, stopName}
  feeMonthly  Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bus_route")
}

/// Calendar and school events.
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  category    String   // Holiday, Examination, General
  term        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([category])
  @@map("calendar_event")
}
